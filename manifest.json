{
  "manifest_version": 3,
  "name": "osu! avatar downloader",
  "version": "1.1",
  "description": "alllows you to download osu! avatars with one click",
  "permissions": [
    "downloads"
  ],
  "host_permissions": [
    "https://a.ppy.sh/*",
    "https://osu.ppy.sh/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://osu.ppy.sh/users/*",
        "https://osu.ppy.sh/u/*",
        "https://osu.ppy.sh/home"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "icons": {
    "48": "icon.png"
  }
}